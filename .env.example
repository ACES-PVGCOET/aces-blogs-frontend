# ── Database ──────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the real values before running Prisma.
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/goodgame?schema=public&connect_timeout=3"

# ── Next.js ──────────────────────────────────────────────────────────────────
# Set to the public URL of your deployment (used by Next.js internals).
# In local dev this is usually http://localhost:3000
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
